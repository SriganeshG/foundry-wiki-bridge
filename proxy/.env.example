# Where Outline is, as seen from the proxy. Inside a Docker network this is the container name.
OUTLINE_URL=http://outline:3000
# What users click to open a document in the wiki. Defaults to OUTLINE_URL.
OUTLINE_PUBLIC_URL=https://wiki.example.com
# An Outline API key. Scope it to collections.list, documents.* and attachments.* when you create it.
OUTLINE_API_KEY=ol_api_...
# Shared secret the Foundry module presents. Generate one: openssl rand -hex 32
BRIDGE_SECRET=
# Comma-separated browser origins allowed to call the proxy: the addresses players open Foundry on.
ALLOWED_ORIGINS=https://foundry.example.com
# Listen port (and optional bind address).
PORT=3002
HOST=0.0.0.0
